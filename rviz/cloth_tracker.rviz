Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /TF1
        - /Cloth Real-time Position (Point)1
        - /Cloth Flight Path (Yellow Arc)1
        - /Cloth Measured Trajectory (Path)1
        - /Theoretical Trajectory (shooter_calculator)1
      Splitter Ratio: 0.5
    Tree Height: 557
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (Ground)
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 30
      Color: 160; 160; 164
      Alpha: 0.4
      Reference Frame: base_link

    - Class: rviz_default_plugins/TF
      Name: TF (base_link & flying_cloth)
      Enabled: true
      Show Axes: true
      Show Names: true
      Show Arrows: true
      Marker Scale: 0.4
      Update Interval: 0

    - Class: rviz_default_plugins/PointStamped
      Name: Cloth Real-time Position (Point)
      Enabled: true
      Topic:
        Value: /cloth/position
        Depth: 10
      Color: 255; 40; 40
      Radius: 0.10
      History Length: 100

    - Class: rviz_default_plugins/Marker
      Name: Cloth Flight Path (Yellow Arc)
      Enabled: true
      Topic:
        Value: /cloth/trajectory_marker
        Depth: 10

    - Class: rviz_default_plugins/Path
      Name: Cloth Measured Trajectory (Path)
      Enabled: true
      Topic:
        Value: /cloth/measured_path
        Depth: 10
      Color: 255; 200; 0
      Alpha: 0.9
      Line Style: Lines
      Line Width: 0.03

    - Class: rviz_default_plugins/PointCloud2
      Name: Segmented Cloth PointCloud
      Enabled: true
      Topic:
        Value: /cloth/cluster_points
        Depth: 5
      Color: 0; 255; 200
      Color Transformer: FlatColor
      Size (Pixels): 4
      Style: Points

    - Class: rviz_default_plugins/MarkerArray
      Name: Theoretical Trajectory (shooter_calculator)
      Enabled: true
      Topic:
        Value: /shooter_calculator/trajectory_markers
        Depth: 10

  Global Options:
    Background Color: 30; 33; 42
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 6.0
      Eye:
        X: 2.0
        Y: -4.5
        Z: 3.5
      Focal Point:
        X: 1.5
        Y: 0.0
        Z: 0.8
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.55
      Target Frame: base_link
      Value: Orbit (rviz)
      Yaw: 1.25
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 850
  Hide Left Dock: false
  Hide Right Dock: false
  Width: 1280
