Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /TF1
        - /Cloth Real-time Position (Point)1
        - /Cloth Flight Path (Yellow Arc)1
        - /Cloth Measured Trajectory (Path)1
        - /Theoretical Trajectory (shooter_calculator)1
      Splitter Ratio: 0.5
    Tree Height: 557
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (Ground)
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 30
      Color: 160; 160; 164
      Alpha: 0.4
      Reference Frame: base_link

    - Class: rviz_default_plugins/TF
      Name: TF (base_link & flying_cloth)
      Enabled: true
      Show Axes: true
      Show Names: true
      Show Arrows: true
      Marker Scale: 0.4
      Update Interval: 0

    - Class: rviz_default_plugins/PointStamped
      Name: Cloth Real-time Position (Point)
      Enabled: true
      Topic:
        Value: /cloth/position
        Depth: 10
      Color: 255; 40; 40
      Radius: 0.10
      History Length: 100

    - Class: rviz_default_plugins/Marker
      Name: Cloth Flight Path (Yellow Arc)
      Enabled: true
      Topic:
        Value: /cloth/trajectory_marker
        Depth: 10

    - Class: rviz_default_plugins/Path
      Name: Cloth Measured Trajectory (Path)
      Enabled: true
      Topic:
        Value: /cloth/measured_path
        Depth: 10
      Color: 255; 200; 0
      Alpha: 0.9
      Line Style: Lines
      Line Width: 0.03

    - Class: rviz_default_plugins/MarkerArray
      Name: Theoretical Trajectory (shooter_calculator)
      Enabled: true
      Topic:
        Value: /shooter_calculator/trajectory_markers
        Depth: 10

  Global Options:
    Background Color: 30; 33; 42
    Fixed Frame: base_link
    Frame Rate: 30
Window Geometry:
  Height: 850
  Width: 1200
